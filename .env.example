# ============================================================
# SAO — Environment Configuration
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit real credentials. Secrets are server-side only.
# ============================================================

# === GENERAL (Required) ===
PORT=3000
NODE_ENV=production
# Primary frontend origin (used for CORS). Falls back to CORS_ORIGIN.
FRONTEND_URL=https://your-domain.com
# Fallback CORS origin if FRONTEND_URL is unset
CORS_ORIGIN=http://localhost:5173

# === DATABASE (CRITICAL) ===
DB_HOST=localhost
DB_PORT=3306
DB_USER=sao
DB_PASSWORD=change_me
DB_NAME=sao
# Optional: set DATABASE_URL to override individual DB_* vars
# DATABASE_URL=mysql://sao:password@host:3306/sao

# === SECURITY (CRITICAL) ===
JWT_SECRET=generate_with_openssl_rand_hex_32

# Also add a registration invite for your admin:
# 1. Start SAO, login as admin
# 2. Go to Registration Access in the dashboard
# 3. Add your email with role "admin"
# 4. Register via the login page with the invited email

# === SEARCH (Tavily) — Gap discovery provider ===
# Get your API key at https://tavily.com
# Without this, gap discovery will not work — all searches return empty.
TAVILY_API_KEY=tvly-...
# (Deprecated) Old Google Custom Search credentials. No longer used by
# the discovery pipeline — kept for backwards compatibility only.
# GOOGLE_SEARCH_API_KEY=AIza...
# GOOGLE_SEARCH_CX=your_search_engine_id

# === GITHUB ===
GITHUB_TOKEN=ghp_...

# === PAYMENTS — STRIPE (Required for existing Stripe integration) ===
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# === CRYPTO PAYMENTS — NOWPayments ===
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_API_URL=https://api.nowpayments.io
# Optional: explicit webhook callback URL. When unset the handler derives
# the URL from FRONTEND_URL (the base path /api/crypto/webhook is appended).
# CRYPTO_WEBHOOK_URL=https://your-domain.com/api/crypto/webhook

# === SAO PRICE (server-controlled, client cannot manipulate) ===
SAO_PRICE_AMOUNT=10.00
SAO_PRICE_CURRENCY=USD

# === LLM ROUTER — Multi-Provider Rotation (Phase 12+) ===
#
# SAO uses a provider-agnostic LLM router. Every AI call goes through the
# router, which selects the best available model and falls back through
# configured providers on failure (rate limit, timeout, server error, etc.).
#
# Providers:
#   groq       — Primary (existing). Models: openai/gpt-oss-120b, openai/gpt-oss-20b
#   cerebras   — Fallback. Models: llama-3.3-70b, qwen-3-32b
#   gemini     — Long-context / project analysis. Model: gemini-2.0-flash
#   openrouter — Emergency fallback router to alternative models.
#
# All providers are OPTIONAL. Missing credentials simply disable that provider
# at runtime. At least ONE provider must be configured for AI generation.
#
# ---- Provider API Keys (server-side only, NEVER exposed to client) ----
# GROQ_API_KEY=gsk_...
# CEREBRAS_API_KEY=your-cerebras-key
# GEMINI_API_KEY=your-gemini-key
# OPENROUTER_API_KEY=your-openrouter-key

# ---- Router Tuning (optional) ----
# Maximum provider attempts per logical request (default: all candidates)
# MAX_PROVIDER_ATTEMPTS=4
# Base cooldown (ms) after a rate-limit response (default: 30000)
# LLM_COOLDOWN_BASE_MS=30000

# ---- Groq (existing primary) ----
# TPM limit for routing estimates (default: 8000; set based on your quota)
# GROQ_TPM_LIMIT=8000
# Override primary model id:
# GROQ_MODEL_PRIMARY=openai/gpt-oss-120b
# Override fallback model id:
# GROQ_MODEL_FALLBACK=openai/gpt-oss-20b
# Disable a model config:
# GROQ_PRIMARY_ENABLED=true
# GROQ_FALLBACK_ENABLED=true

# ---- Cerebras ----
# CEREBRAS_MODEL_PRIMARY=gpt-oss-120b
# CEREBRAS_MODEL_SECONDARY=gemma-4-31b
# CEREBRAS_PRIMARY_ENABLED=true
# CEREBRAS_SECONDARY_ENABLED=true
# Optional: override API base URL
# CEREBRAS_API_URL=https://api.cerebras.ai/v1

# ---- Google Gemini (AI Studio OpenAI-compatible endpoint) ----
# GEMINI_MODEL_PRIMARY=gemini-3.1-flash-lite
# GEMINI_PRIMARY_ENABLED=true
# Optional: override API base URL
# GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/openai

# ---- OpenRouter (emergency fallback) ----
# OPENROUTER_MODEL=openai/gpt-oss-120b
# OPENROUTER_ENABLED=true
# Note: OpenRouter may charge per-token fees. Set priority=20 (lowest) in registry.

# === EMAIL (Resend) ===
# Resend API key from https://resend.com/api-keys
RESEND_API_KEY=re_...
# Verified sending domain/email. The domain MUST be verified in Resend:
# 1. Go to https://resend.com/domains
# 2. Add your domain (e.g. sao-system.com)
# 3. Add the DNS records Resend provides
# 4. Wait for verification (green checkmark)
# 5. Set RESEND_FROM_EMAIL to an address on that domain
# Default: noreply@sao-system.com (will warn if not changed)
RESEND_FROM_EMAIL=noreply@your-verified-domain.com
# Optional display name for the sender (default: "SAO")
# RESEND_FROM_NAME=SAO

# === SLACK ===
SLACK_BOT_TOKEN=xoxb-...
SLACK_CHANNEL=#alerts

# === CLOUDFLARE R2 (Optional) ===
CLOUDFLARE_R2_ACCESS_KEY_ID=...
CLOUDFLARE_R2_SECRET_ACCESS_KEY=...
CLOUDFLARE_R2_BUCKET_NAME=...

# === ADVERTISING PROVIDERS (Phase 13) ===
# Revenue percentage allocated to advertising (0-100, default: 0)
# DO NOT set this without explicit project owner approval.
ADVERTISING_REVENUE_PERCENTAGE=0
# Set to "true" to enable real paid advertising. Default: false.
# ADVERTISING_LIVE_MODE=false
#
# Advertising channel credentials (all optional — no real ads without them):
# GOOGLE_ADS_CLIENT_ID=
# GOOGLE_ADS_CLIENT_SECRET=
# GOOGLE_ADS_DEVELOPER_TOKEN=
# META_ADS_ACCESS_TOKEN=
# META_ADS_ACCOUNT_ID=
# TIKTOK_ADS_ACCESS_TOKEN=
# TIKTOK_ADS_ADVERTISER_ID=
# Free/organic channels (organic_social, content_marketing, community_engagement)
# require no credentials and are always available.
VERCEL_API_TOKEN=
# Optional: only needed if deploying under a Vercel team
# VERCEL_TEAM_ID=

# === ANALYTICS (Optional, client-exposed) ===
VITE_ANALYTICS_ENDPOINT=https://umami.example.com
VITE_ANALYTICS_WEBSITE_ID=uuid
