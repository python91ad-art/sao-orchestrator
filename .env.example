# ============================================================
# SAO — Environment Configuration
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit real credentials. Secrets are server-side only.
# ============================================================

# === GENERAL (Required) ===
PORT=3000
NODE_ENV=production
# Primary frontend origin (used for CORS). Falls back to CORS_ORIGIN.
FRONTEND_URL=https://your-domain.com
# Fallback CORS origin if FRONTEND_URL is unset
CORS_ORIGIN=http://localhost:5173

# === DATABASE (CRITICAL) ===
DB_HOST=localhost
DB_PORT=3306
DB_USER=sao
DB_PASSWORD=change_me
DB_NAME=sao
# Optional: set DATABASE_URL to override individual DB_* vars
# DATABASE_URL=mysql://sao:password@host:3306/sao

# === SECURITY (CRITICAL) ===
JWT_SECRET=generate_with_openssl_rand_hex_32

# === AI MODELS (CRITICAL) ===
GROQ_API_KEY=gsk_...

# === SEARCH ===
GOOGLE_SEARCH_API_KEY=AIza...
GOOGLE_SEARCH_CX=your_search_engine_id

# === GITHUB ===
GITHUB_TOKEN=ghp_...

# === PAYMENTS — STRIPE (Required for existing Stripe integration) ===
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# === EMAIL ===
RESEND_API_KEY=re_...

# === SLACK ===
SLACK_BOT_TOKEN=xoxb-...
SLACK_CHANNEL=#alerts

# === CLOUDFLARE R2 (Optional) ===
CLOUDFLARE_R2_ACCESS_KEY_ID=...
CLOUDFLARE_R2_SECRET_ACCESS_KEY=...
CLOUDFLARE_R2_BUCKET_NAME=...

# === VERCEL (Required for Vercel deployment pipeline) ===
VERCEL_API_TOKEN=
# Optional: only needed if deploying under a Vercel team
# VERCEL_TEAM_ID=

# === ANALYTICS (Optional, client-exposed) ===
VITE_ANALYTICS_ENDPOINT=https://umami.example.com
VITE_ANALYTICS_WEBSITE_ID=uuid
